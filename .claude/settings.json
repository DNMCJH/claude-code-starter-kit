{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git rebase *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git push *)",
      "Bash(git branch *)",
      "Bash(gh *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(curl *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(echo *)",
      "Bash(pwd *)",
      "Bash(which *)",
      "Bash(where *)",
      "Bash(diff *)",
      "Bash(grep *)",
      "Bash(cd *)",
      "Bash(code *)",
      "Write",
      "Edit"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/scripts/bash_safety_guard.py 2>/dev/null || python .claude/scripts/bash_safety_guard.py",
            "statusMessage": "Safety check..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/scripts/pre_write_think.py 2>/dev/null || python .claude/scripts/pre_write_think.py",
            "statusMessage": "Think before write..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/scripts/post_write_check.py 2>/dev/null || python .claude/scripts/post_write_check.py",
            "statusMessage": "Checking syntax..."
          }
        ]
      }
    ]
  }
}
