{
  "_comment": "This file goes to ~/.claude/settings.json (your home directory)",
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "<YOUR_API_KEY_HERE>",
    "ANTHROPIC_BASE_URL": "<YOUR_API_BASE_URL_HERE>"
  },
  "theme": "dark-daltonized",
  "effortLevel": "high",
  "includeCoAuthoredBy": false,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"$d=Get-Date -Format 'yyyy-MM-dd ddd HH:mm'; $b=(git rev-parse --abbrev-ref HEAD 2>$null); if($b){Write-Output \\\"[ctx] $d | branch: $b\\\"}else{Write-Output \\\"[ctx] $d\\\"}\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"$j=$input|Out-String|ConvertFrom-Json; $f=$j.tool_input.file_path; if($f -and $f -match '\\.py$' -and (Test-Path $f)){& 'python' -m black -q $f 2>$null}\""
          }
        ]
      }
    ]
  }
}
